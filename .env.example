# RRB CBT Environment Configuration Example
# Rename this file to .env and fill in your actual configurations.

# Secret Key for JWT Token Generation (Keep this secret!)
JWT_SECRET_KEY=your_custom_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# Redis Queue Configuration (Optional, fallback to threading if Redis is not running)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
